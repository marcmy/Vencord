{
    "name": "vencord",
    "version": "1.15.17",
    "private": "true",
    "description": "The cutest Discord client mod",
    "homepage": "https://github.com/Vendicated/Vencord#readme",
    "bugs": {
        "url": "https://github.com/Vendicated/Vencord/issues"
    },
    "license": "GPL-3.0-or-later",
    "author": "Vendicated",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Vendicated/Vencord.git"
    },
    "scripts": {
        "build": "node --require=./scripts/suppressExperimentalWarnings.js scripts/build/build.mjs",
        "buildStandalone": "pnpm build --standalone",
        "buildWeb": "node --require=./scripts/suppressExperimentalWarnings.js scripts/build/buildWeb.mjs",
        "buildWebStandalone": "pnpm buildWeb --standalone",
        "buildReporter": "pnpm buildWebStandalone --reporter --skip-extension",
        "buildReporterDesktop": "pnpm build --reporter",
        "watch": "pnpm build --watch",
        "dev": "pnpm watch",
        "watchWeb": "pnpm buildWeb --watch",
        "generatePluginJson": "tsx scripts/generatePluginList.ts",
        "generateTypes": "tspc --emitDeclarationOnly --declaration --outDir packages/vencord-types --allowJs false",
        "inject": "node scripts/runInstaller.mjs -- --install",
        "uninject": "node scripts/runInstaller.mjs -- --uninstall",
        "lint": "oxlint",
        "fmt": "oxfmt \"**/*.{css,html,json,yml,yaml}\"",
        "fmt:check": "pnpm fmt --check",
        "lint:fix": "pnpm lint --fix",
        "test": "pnpm test:ts && pnpm buildStandalone && pnpm buildWebStandalone && pnpm lint && pnpm fmt:check && pnpm generatePluginJson",
        "test:ts": "tsc --noEmit",
        "test:questFocusPause": "node scripts/testQuestFocusPause.mjs",
        "test:expressionPickerFocus": "node scripts/testExpressionPickerFocus.mjs",
        "bump": "./scripts/bump.sh"
    },
    "dependencies": {
        "@intrnl/xxhash64": "^0.1.2",
        "@vap/core": "0.0.12",
        "@vap/shiki": "0.10.5",
        "@vencord/monaco-editor": "0.57.0-beta.4",
        "fflate": "^0.8.3",
        "gifenc": "github:mattdesl/gifenc#64842fca317b112a8590f8fef2bf3825da8f6fe3",
        "nanoid": "^6.0.2",
        "virtual-merge": "^1.0.1"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/chrome": "^0.3.7",
        "@types/lodash": "^4.17.27",
        "@types/node": "^26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/yazl": "^3.3.1",
        "@vencord/discord-types": "workspace:",
        "diff": "^9.0.0",
        "esbuild": "^0.28.2",
        "eslint-plugin-path-alias": "2.1.0",
        "eslint-plugin-simple-header": "^1.2.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "html-minifier-terser": "^7.2.0",
        "lodash": "^4.18.1",
        "moment": "^2.31.0",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.90.0",
        "oxlint-tsgolint": "^7.0.2005",
        "p-limit": "^7.3.3",
        "puppeteer-core": "^25.16.0",
        "standalone-electron-types": "^41.2.1",
        "svgo": "^4.1.0",
        "ts-patch": "^3.3.0",
        "ts-pattern": "^5.9.2",
        "tsx": "^4.23.15",
        "type-fest": "^5.10.0",
        "typescript": "^7.0.2",
        "typescript-transform-paths": "^4.0.0"
    },
    "engines": {
        "node": ">=22"
    },
    "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
